import cv2
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

# ============================================================
# User settings
# ============================================================

IMAGE_FILE = "batemoP50.png"
OUTPUT_CSV = "ocv.csv"

# HSV range for orange (adjust if necessary)
LOWER_ORANGE = np.array([5, 80, 80])
UPPER_ORANGE = np.array([25, 255, 255])

# Desired output coordinate ranges
OUTPUT_X_MIN = (5000 - 4865) / 5000
OUTPUT_X_MAX = 1

OUTPUT_Y_MIN = 2.5
OUTPUT_Y_MAX = 4.2-0.044125

# Ignore tiny detections
MIN_PIXELS_PER_COLUMN = 2

# ============================================================

img = cv2.imread(IMAGE_FILE)

if img is None:
    raise FileNotFoundError(IMAGE_FILE)

height, width = img.shape[:2]

# Convert to HSV
hsv = cv2.cvtColor(img, cv2.COLOR_BGR2HSV)

# Threshold orange
mask = cv2.inRange(hsv, LOWER_ORANGE, UPPER_ORANGE)

points = []

# ------------------------------------------------------------
# Scan image left -> right
# ------------------------------------------------------------
for x in range(width):

    column = mask[:, x]

    ys = np.where(column > 0)[0]

    if len(ys) < MIN_PIXELS_PER_COLUMN:
        continue

    # Weight using mask intensity (supports antialiasing if mask isn't binary)
    weights = column[ys].astype(np.float64)

    y_center = np.sum(ys * weights) / np.sum(weights)

    points.append((float(x), float(y_center)))

if len(points) == 0:
    raise RuntimeError("No orange line detected.")

points = np.array(points)

raw_x = points[:, 0]
raw_y = points[:, 1]

# ------------------------------------------------------------
# Scaling
# ------------------------------------------------------------

# ------------------------------------------------------------
# Convert image coordinates to graph coordinates
# ------------------------------------------------------------

# X is unchanged
# graph_x = raw_x.copy()
graph_x = (width - 1) - raw_x

# Flip Y so 0 is at the bottom of the image
graph_y = (height - 1) - raw_y

captured_x_min = graph_x.min()
captured_x_max = graph_x.max()

captured_y_min = graph_y.min()
captured_y_max = graph_y.max()


def scale(values, in_min, in_max, out_min, out_max):
    if abs(in_max - in_min) < 1e-12:
        return np.full_like(values, out_min)

    return (
        (values - in_min)
        * (out_max - out_min)
        / (in_max - in_min)
        + out_min
    )


scaled_x = scale(
    graph_x,
    captured_x_min,
    captured_x_max,
    OUTPUT_X_MIN,
    OUTPUT_X_MAX,
)

scaled_y = scale(
    graph_y,
    captured_y_min,
    captured_y_max,
    OUTPUT_Y_MIN,
    OUTPUT_Y_MAX,
)

# ------------------------------------------------------------
# Save CSV
# ------------------------------------------------------------

plt.plot(scaled_x, scaled_y)
plt.show()

df = pd.DataFrame(
    {
        # "raw_x": raw_x,
        # "raw_y": raw_y,
        "scaled_x": scaled_x,
        "scaled_y": scaled_y,
    }
)

df.to_csv(OUTPUT_CSV, index=False)

print(f"Saved {len(df)} samples to {OUTPUT_CSV}")